{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["ESNext"],
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true,
    "forceConsistentCasingInFileNames": true,
    "strict": false,
    "skipLibCheck": true,
    "types": ["@cloudflare/workers-types"]
  },
  "exclude": ["public"],
  "include": ["**/*.ts", "**/*.tsx"]
}
