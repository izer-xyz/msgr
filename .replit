modules = ["nodejs-24"]

[nix]
channel = "stable-25_05"
packages = ["vim"]

[workflows]
runButton = "ADMIN"

[[workflows.workflow]]
name = "APIS"
mode = "parallel"
author = 3410761

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd api && npm install && npm run dev "

[[workflows.workflow]]
name = "ADMIN"
mode = "parallel"
author = 3410761

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd admin && npm install && npm run dev"

[[workflows.workflow]]
name = "IMG"
mode = "sequential"
author = 3410761

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd img && npm install && npm run dev"

[[ports]]
localPort = 5173
externalPort = 5173

[[ports]]
localPort = 5174
externalPort = 5000

[[ports]]
localPort = 5175
externalPort = 3000

[[ports]]
localPort = 8000
externalPort = 8000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8099
externalPort = 8099

[[ports]]
localPort = 9229
externalPort = 3002
exposeLocalhost = true

[[ports]]
localPort = 9230
externalPort = 80
exposeLocalhost = true

[[ports]]
localPort = 9231
externalPort = 3001
exposeLocalhost = true
