modules = ["nodejs-24"]

[nix]
channel = "stable-25_05"
packages = ["vim"]

[workflows]
runButton = "ADMIN"

[[workflows.workflow]]
name = "trmnl_ADM"
mode = "parallel"
author = 3410761

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd pages/trmnl && npm install && npm start"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd workers/trmnl-img && npm install && npm run dev "

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd workers/trmnl-api && npm install && npm run dev "

[[workflows.workflow]]
name = "trmnl_APIS"
mode = "parallel"
author = 3410761

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd workers/trmnl-img && npm install && npm run dev "

[[workflows.workflow]]
name = "ADMIN"
mode = "sequential"
author = 3410761

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd workers/admin && npm run dev"

[[ports]]
localPort = 5173
externalPort = 5173

[[ports]]
localPort = 5174
externalPort = 5000

[[ports]]
localPort = 8000
externalPort = 8000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8099
externalPort = 8099

[[ports]]
localPort = 9229
externalPort = 3002
exposeLocalhost = true
